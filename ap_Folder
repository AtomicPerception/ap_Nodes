import os
import hashlib

VERSION = 1.3

class ap_Folder:
	@classmethod
	def INPUT_TYPES(cls):
		EXTENSIONS = {
			"JPEG": [".jpg", ".jpeg"],
			"PNG": [".png"],
			"Images": [".jpg", ".jpeg", ".png"],
			"Audio": [".mp3", ".wav"],
			"Video": [".mp4"],
			"WAV": [".wav"],
			"MP3": [".mp3"],
			"Text": [".txt"],
		}

		return {
			"required": {
				"directory": ("STRING", {
					"default": "",
					"multiline": False
				}),
				"extension": (list(EXTENSIONS.keys()),),
				"index": ("INT", {
					"default": 0,
					"min": 0,
					"step": 1
				}),
				"loop": ("BOOLEAN", {"default": False}),
			}
		}

	RETURN_TYPES = ("STRING", "STRING", "STRING", "STRING", "STRING", "INT")
	RETURN_NAMES = (
		"files",
		"index_file",
		"path",
		"filename",
		"file_extension",
		"index_mod",
	)
	FUNCTION = "get_files"
	CATEGORY = "ap_Nodes"

	@classmethod
	def IS_CHANGED(cls, directory="", extension="", index=0, **kwargs):
		"""
		Re-run only when:
		- directory changes
		- extension changes
		- index changes
		- directory file list changes
		"""
		if not directory or not os.path.isdir(directory):
			return "invalid_directory"

		EXTENSIONS = {
			"JPEG": [".jpg", ".jpeg"],
			"PNG": [".png"],
			"Images": [".jpg", ".jpeg", ".png"],
			"Audio": [".mp3", ".wav"],
			"Video": [".mp4"],
			"WAV": [".wav"],
			"MP3": [".mp3"],
			"Text": [".txt"],
		}

		# Resolve the selected extension name to its actual extensions.
		extensions = EXTENSIONS.get(extension, [])

		try:
			files = sorted(
				f for f in os.listdir(directory)
				if any(f.lower().endswith(ext) for ext in extensions)
			)
		except Exception:
			return "dir_error"

		hash_input = (
			directory,
			extension,
			index,
			tuple(files),
		)

		return hashlib.md5(str(hash_input).encode("utf-8")).hexdigest()

	def get_files(self, directory, extension, index, loop):
		if not os.path.isdir(directory):
			return ("", "", "", "", "", 0)

		EXTENSIONS = {
			"JPEG": [".jpg", ".jpeg"],
			"PNG": [".png"],
			"Images": [".jpg", ".jpeg", ".png"],
			"Audio": [".mp3", ".wav"],
			"Video": [".mp4"],
			"WAV": [".wav"],
			"MP3": [".mp3"],
			"Text": [".txt"],
		}

		# Resolve the selected extension name to its actual extensions.
		extensions = EXTENSIONS.get(extension, [])

		files = [
			os.path.join(directory, f)
			for f in sorted(os.listdir(directory))
			if any(f.lower().endswith(ext) for ext in extensions)
		]

		files_csv = ",\n".join(files)

		if not files:
			return (files_csv, "", "", "", "", 0)

		# Calculate the modulus of the index against the file count in this folder.
		index_mod = 0
		l = len(files)
		i = index
		while(i>=l):
			index_mod += 1
			i -= l
			
		if (loop == False):
			# Clamp index safely
			#index = max(0, min(index, len(files) - 1))
			if index <= len(files):
				index_file = files[index]
			else:
				#Force an error out.
				index_file = ""
		else:
			# Looping.
			i = index - (l*index_mod)
			index_file = files[i]

		# Parse index_file
		path, base = os.path.split(index_file)
		filename, file_extension = os.path.splitext(base)

		return (
			files_csv,
			index_file,
			path,
			filename,
			file_extension,
			index_mod,
		)


