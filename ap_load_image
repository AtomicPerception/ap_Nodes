import torch
import numpy as np
from PIL import Image
import os

class ap_LoadImage:
    @classmethod
    def INPUT_TYPES(cls):
        return {
            "required": {
                "image_filename": ("STRING", {"default": ""}),
            }
        }

    RETURN_TYPES = ("IMAGE",)
    RETURN_NAMES = ("image",)
    FUNCTION = "load_image"
    CATEGORY = "ap_Nodes"

    def load_image(self, image_filename):
        img_tensor = None

        if os.path.isfile(image_filename):
            try:
                img = Image.open(image_filename).convert("RGB")
                img_np = np.array(img).astype(np.float32) / 255.0
                img_tensor = torch.from_numpy(img_np)[None,]
            except Exception:
                img_tensor = None

        if img_tensor is None:
            black = np.zeros((512, 512, 3), dtype=np.float32)
            img_tensor = torch.from_numpy(black)[None,]

        return (img_tensor,)


NODE_CLASS_MAPPINGS = {
    "ap_LoadImage": ap_LoadImage
}

NODE_DISPLAY_NAME_MAPPINGS = {
    "ap_LoadImage": "AP Load Single Image"
}
